# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Google Service Account Credentials (Server-Side Only)
# Used for uploading candidate interview videos to Google Drive and logging data to Google Sheets.
GOOGLE_SERVICE_ACCOUNT_EMAIL="genz-interview-storage@genz-upskill-foundation.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY=""

# Google Drive Storage Folder (Optional: Specific folder ID to organize interview recordings)
GOOGLE_DRIVE_FOLDER_ID=""

# Google Sheets Target Spreadsheet for Candidate & Interview Records
GOOGLE_SHEETS_SPREADSHEET_ID="1q7h2pDNtuF3t7FFsErDcmNURt7YDzKAwYTgLTe04O0k"
GOOGLE_SHEETS_SHEET_NAME="Candidate_Interviews"

# Admin Access Credentials (Required for HR & Candidate Review Desk)
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
