# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ==============================================================================
# Backblaze B2 Video Storage (S3-Compatible Object Storage for Interview Recordings)
# ==============================================================================
# Create a private bucket in Backblaze B2 and generate an Application Key with read/write access.
# Videos are uploaded to your private bucket and streamed to Admin via 1-hour presigned URLs.
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME=""
B2_ENDPOINT="https://s3.us-west-004.backblazeb2.com"

# ==============================================================================
# Google Sheets Integration (Service Account)
# ==============================================================================
# Google Sheets synchronization uses Google Service Account authentication.
GOOGLE_SERVICE_ACCOUNT_EMAIL="genz-interview-storage@genz-upskill-foundation.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEETS_SPREADSHEET_ID="1q7h2pDNtuF3t7FFsErDcmNURt7YDzKAwYTgLTe04O0k"
GOOGLE_SHEETS_SHEET_NAME="Candidate_Interviews"

# ==============================================================================
# Admin Access Credentials (Required for HR & Candidate Review Desk)
# ==============================================================================
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
